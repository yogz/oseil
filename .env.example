# Names only. Locally, mise loads these from Proton Pass (see mise-supabase.tmpl);
# on Vercel they are project environment variables.

# Public: the browser uses them to reach the Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: the Vercel cron sends it to /api/keep-alive.
CRON_SECRET=

# Never in app/, lib/ or components/: only scripts/ and e2e/ use it, to create
# and delete test users. Not set on Vercel.
SUPABASE_SECRET_KEY=
